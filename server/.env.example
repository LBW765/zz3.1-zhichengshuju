# 后端服务环境变量示例
# 复制为 .env 后填入实际值（.env 不会提交到仓库）

# MySQL 数据库配置（按本地或授权环境填写）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=
DB_NAME=your_database_name

# HR 模块敏感字段加密密钥（AES-256-GCM），32 字节 hex 或 base64
# 生成方式（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
# 注意：密钥一旦投入使用不能再变更，否则历史密文将无法解密
HR_CRYPTO_KEY=

# 上传目录（默认 server/uploads）
# UPLOAD_DIR=/data/uploads

# 使用内存 mock 后端时设为 true；mock 模式不连接 MySQL
MOCK_BACKEND=false
