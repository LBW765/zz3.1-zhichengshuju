# 后端服务环境变量示例
# 复制为 .env 后填入实际值（.env 不会提交到仓库）

# MySQL 数据库配置（按本地或授权环境填写）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=
DB_NAME=your_database_name

# AI Demo 默认使用内存 Mock 数据，不需要 MySQL；服务重启会恢复种子数据。
# 只有明确设置 AI_MOCK=false 时才连接下面的独立演示库配置。
AI_MOCK=true
AI_DB_HOST=127.0.0.1
AI_DB_PORT=3306
AI_DB_USER=root
AI_DB_PASSWORD=
AI_DB_NAME=jian_ai_demo
AI_PORT=3132

# HR 模块敏感字段加密密钥（AES-256-GCM），32 字节 hex 或 base64
# 生成方式（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
# 注意：密钥一旦投入使用不能再变更，否则历史密文将无法解密
HR_CRYPTO_KEY=

# 上传目录（默认 server/uploads）
# UPLOAD_DIR=/data/uploads

# 使用内存 mock 后端时设为 true；mock 模式不连接 MySQL
MOCK_BACKEND=false
